{
  "name": "ki-cl-back",
  "version": "2.0.0",
  "description": "Ki.CL Backend - Apollo GraphQL API",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "Server",
    "Codegen",
    "Client"
  ],
  "scripts": {
    "development": "yarn codegen && yarn workspace @ki-cl/client run build && NODE_ENV=development tsx watch Server/index.ts",
    "production": "yarn codegen && yarn workspace @ki-cl/client run build && NODE_ENV=production tsx Server/index.ts",
    "start": "yarn run development",
    "build": "yarn codegen && tsc --noEmit",
    "lint": "eslint Server/ --ext .ts",
    "codegen": "yarn workspace codegen run generate",
    "codegen:operations": "yarn workspace codegen run operations"
  },
  "author": "Keni Lam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenilam/Ki.CL-back.git"
  },
  "devDependencies": {
    "@types/app-root-path": "^3.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
