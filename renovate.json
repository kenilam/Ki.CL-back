{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "commitBody": "renovate updates",
  "ignorePaths": [],
  "baseBranches": [
    "develop"
  ],
  "schedule": [
    "every weekend"
  ],
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": ">=1.0.0",
      "labels": [
        "minor-patch"
      ]
    },
    {
      "description": "Tooling that never ships to the browser. Merged once CI passes.",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": ">=1.0.0",
      "automerge": true
    },
    {
      "description": "Shared with the Ki.CL host as Module Federation singletons, so both sides have to agree on the version. Always reviewed.",
      "groupName": "federation shared singletons",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@apollo/client",
        "graphql",
        "graphql-ws"
      ],
      "labels": [
        "federation"
      ],
      "automerge": false
    },
    {
      "description": "Held with the Ki.CL host, where @react-three/fiber 9 declares react and react-dom <19.3. Lift both together.",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "allowedVersions": "<19.3"
    }
  ]
}
