NODE_ENV=development
PORT=3100

# MongoDB
MONGODB_ATLAS_URI=
# Database in the cluster. Production uses `production`; unset means `test`.
# MONGODB_DATABASE=test

# JWT
JWT_ACCESS_TOKEN_PRIVATE_KEY=
JWT_REFRESH_TOKEN_PRIVATE_KEY=
SALT=10

# Security
CORS_ORIGINS=https://ki-cl.com,https://localhost:3011
WHITE_LIST_OPERATION=ExchangeToken
# Proxy hops in front of this server, so req.ip is the visitor. Behind the
# Ki.CL web server it is not used: that server sends the visitor's address in
# x-kicl-client-address, since it reaches us through the VPC. Per-address
# limits stay off in production until one of the two is present.
# TRUST_PROXY=2
# Key for hashing addresses before they are stored. Falls back to the JWT access key.
# ADDRESS_HASH_SECRET=
# New anonymous sessions one address may get per day.
# ANONYMOUS_SESSIONS_PER_ADDRESS_PER_DAY=10

# Cloudflare Turnstile. Unset outside production lets every request through.
# Test secrets: 1x0000000000000000000000000000000AA passes, 2x0000000000000000000000000000000AA fails.
# TURNSTILE_SECRET_KEY=
# Hostnames the widget may run on, comma-separated. Unset accepts any.
# TURNSTILE_HOSTNAMES=ki-cl.com,www.ki-cl.com

# Rate Limiting
RATE_LIMIT_PER_DAY=100
# /api requests without a session, per visitor address, per day.
# RATE_LIMIT_PER_ADDRESS_PER_DAY=2000

# GraphQL
GRAPHQL_INTROSPECTION=true
APOLLO_PLAYGROUND=true

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Storage (TaxonVisual PNGs → bucket `taxon-visual`)
# Console: https://console.cloud.google.com/storage/browser/taxon-visual?project=client-458617
GOOGLE_STORAGE_BUCKET_ID=taxon-visual
# Served at /assets/static - the URL segment is fixed, the bucket name is not,
# because bucket names are globally unique and `static` was already taken.
GOOGLE_STORAGE_STATIC_BUCKET_ID=ki-cl-static
GOOGLE_STORAGE_PROXY=/assets
# Full service-account JSON as a single-line string
GOOGLE_STORAGE_SERVICE_ACCOUNT=

# ImageAgent governor - what one caller and the whole service may spend.
# Drawings per caller and overall, messages per caller (each costs a
# classifier call), and the pause between messages. Quota refusals are not
# recorded.
# IMAGE_AGENT_DAILY_LIMIT_PER_USER=5
# IMAGE_AGENT_DAILY_LIMIT_GLOBAL=200
# IMAGE_AGENT_DAILY_MESSAGES_PER_USER=40
# IMAGE_AGENT_DAILY_MESSAGES_GLOBAL=1000
# Different people who may use the agent in a rolling hour.
# IMAGE_AGENT_HOURLY_USERS=10
# IMAGE_AGENT_MIN_INTERVAL_SECONDS=5
# Draw at most this many images per request before accepting the best.
# IMAGE_AGENT_MAX_ATTEMPTS=2
# Clarifying questions before a picture is drawn regardless.
# IMAGE_AGENT_MAX_QUESTIONS=3

# Mailer (future)
MAILER_REGISTRATION_ACTIVATION_URL=

# TaxonVisual providers - quality-first pipeline (each agent retried, then next):
#   text:   OpenAI → Groq → Gemini Flash → Flash Lite → 3.1 Flash Lite
#   images: OpenAI → Cloudflare → Pollinations → Gemini image (paid last)
# Google models are last; each Gemini model uses its own AI Studio quota.
OPENAI_API_KEY=

# Cloudflare Workers AI (free daily neurons; Flux Schnell)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pollinations free Flux (key optional; set POLLINATIONS_IMAGE_ENABLED=false to skip)
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_ENABLED=true

# Groq (free text descriptions)
GROQ_API_KEY=
# Groq is only used once a model is named here.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Gemini (text cascade last; image API is paid last resort)
GEMINI_API_KEY=
# Prefer GEMINI_TEXT_MODELS for the full cascade (comma-separated).
# GEMINI_TEXT_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Or set a preferred first model (remaining defaults still follow):
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
