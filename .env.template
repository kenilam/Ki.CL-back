NODE_ENV=development
PORT=3100

# MongoDB
MONGODB_ATLAS_USERNAME=
MONGODB_ATLAS_PASSWORD=
MONGODB_ATLAS_URI=

# JWT
JWT_ACCESS_TOKEN_PRIVATE_KEY=
JWT_REFRESH_TOKEN_PRIVATE_KEY=
SALT=10

# Security
CORS_ORIGINS=https://ki-cl.com,https://localhost:3011
WHITE_LIST_OPERATION=ExchangeToken

# Rate Limiting
RATE_LIMIT_PER_DAY=100

# GraphQL
GRAPHQL_INTROSPECTION=true
APOLLO_PLAYGROUND=true

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Storage (TaxonVisual PNGs → bucket `taxon-visual`)
# Console: https://console.cloud.google.com/storage/browser/taxon-visual?project=client-458617
GOOGLE_STORAGE_BUCKET_ID=taxon-visual
GOOGLE_STORAGE_PROXY=/assets
# Full service-account JSON as a single-line string
GOOGLE_STORAGE_SERVICE_ACCOUNT=

# Mailer (future)
MAILER_REGISTRATION_ACTIVATION_URL=

# TaxonVisual providers — quality-first pipeline (each agent retried, then next):
#   text:   OpenAI → Groq → Gemini Flash → Flash Lite → 3.1 Flash Lite
#   images: OpenAI → Cloudflare → Pollinations → Gemini image (paid last)
# Google models are last; each Gemini model uses its own AI Studio quota.
OPENAI_API_KEY=

# Cloudflare Workers AI (free daily neurons; Flux Schnell)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pollinations free Flux (key optional; set POLLINATIONS_IMAGE_ENABLED=false to skip)
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_ENABLED=true

# Groq (free text descriptions)
GROQ_API_KEY=
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Gemini (text cascade last; image API is paid last resort)
GEMINI_API_KEY=
# Prefer GEMINI_TEXT_MODELS for the full cascade (comma-separated).
# GEMINI_TEXT_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite
# Or set a preferred first model (remaining defaults still follow):
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
