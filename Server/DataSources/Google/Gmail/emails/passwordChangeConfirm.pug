extends layout

block content
  p(style='margin:0 0 24px;') Someone signed in to your Ki.CL account asked to change its password.
  p(style='margin:0 0 24px;')
    a(href=link style='display:inline-block;padding:12px 20px;background:#18181b;color:#ffffff;border-radius:6px;text-decoration:none;') Confirm the change
  p(style='margin:0 0 16px;font-size:14px;color:#52525b;') The link works for 10 minutes.
  p(style='margin:0;font-size:14px;color:#52525b;') If this was not you, ignore this email. Your password stays the same.
