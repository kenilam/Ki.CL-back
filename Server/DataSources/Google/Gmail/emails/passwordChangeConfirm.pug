extends layout

block content
  p(style='margin:0 0 24px;')= t('password_change_confirm_asked')
  p(style='margin:0 0 24px;')
    a(href=link style='display:inline-block;padding:12px 20px;background:#18181b;color:#ffffff;border-radius:6px;text-decoration:none;')= t('password_change_confirm_action')
  p(style='margin:0 0 16px;font-size:14px;color:#52525b;')= t('password_change_confirm_expiry', { count: minutes })
  p(style='margin:0;font-size:14px;color:#52525b;')= t('password_change_confirm_ignore')
