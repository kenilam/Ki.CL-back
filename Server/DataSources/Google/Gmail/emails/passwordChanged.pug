extends layout

block content
  p(style='margin:0 0 16px;')= t('password_changed_notice')
  if contact
    //- The sentence is one string. It is cut where the address goes, so the address can be a link.
    - const [before, after] = t('password_changed_contact', { contact: '{{contact}}' }).split('{{contact}}')
    p(style='margin:0;font-size:14px;color:#52525b;')
      = before
      a(href=`mailto:${contact}` style='color:#18181b;')= contact
      = after
